FROM python:3.11-slim

WORKDIR /app

COPY utils/hugo_ingest.py utils/canonical_rag_ingest.py utils/utils.py utils/milvus_store.py /app/

RUN pip install --no-cache-dir \
    requests \
    beautifulsoup4 \
    toml \
    pyyaml \
    python-frontmatter==1.1.0 \
    markdownify==1.2.0 \
    html-table-rescuer==0.3.1 \
    pymilvus==2.6.14

ENV PYTHONPATH=/app
