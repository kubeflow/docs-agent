# =============================================================================
# .env.example — Kubeflow Docs Agent CLI (`docs-cli`) Environment Variables
# =============================================================================
# Copy to `.env` (gitignored) or export in your shell before running `docs-cli`.
# Never commit real credentials or OCIDs to git.

# -----------------------------------------------------------------------------
# 1. Oracle Cloud Infrastructure (OCI) Authentication & Target Compartment
# -----------------------------------------------------------------------------
# Option A: Direct environment credentials (recommended for CI / Ephemeral Dev)
OCI_TENANCY="ocid1.tenancy.oc1..aaaaaaa..."
OCI_USER="ocid1.user.oc1..aaaaaaa..."
OCI_FINGERPRINT="aa:bb:cc:dd:ee:ff:00:11:22:33:44:55:66:77:88:99"
OCI_KEY_FILE="~/.oci/oci_api_key.pem"
OCI_KEY_PASSPHRASE=""

# Option B: Use an existing ~/.oci/config profile (when OCI_TENANCY is unset)
OCI_PROFILE="DEFAULT"

# Target OCI Region & Compartment OCID
OCI_REGION="us-chicago-1"
OCI_COMPARTMENT_ID="ocid1.compartment.oc1..aaaaaaa..."

# Optional: Specific GPU OKE node image OCID in your region
OCI_GPU_NODE_IMAGE_ID=""

# -----------------------------------------------------------------------------
# 2. Cluster & LLM Runtime Overrides
# -----------------------------------------------------------------------------
# Set to "false" to skip the GPU node pool and use an external OpenAI-compatible API
DOCS_ENABLE_GPU="true"

# Active in-cluster vLLM profile when GPU is enabled ("gemma4" or "qwen")
DOCS_LLM_PROFILE="gemma4"

# External OpenAI-compatible API credentials (used when DOCS_ENABLE_GPU="false")
OPENAI_API_KEY=""
LLM_BASE_URL="https://api.openai.com/v1"
LLM_MODEL="gpt-4o-mini"

# Hugging Face token (required for gated model weights like Gemma 4 in llm-runtime)
HF_TOKEN=""

# -----------------------------------------------------------------------------
# 3. MCP Server, Milvus & Ingestion Pipeline Credentials
# -----------------------------------------------------------------------------
# Milvus root password (used by Milvus auth & mcp-server-secret; auto-generated if empty)
MILVUS_PASSWORD=""

# GitHub Personal Access Token (used by KFP issues/code ingestion pipelines to avoid rate limits)
GITHUB_TOKEN=""

# Optional: Langfuse observability keys for mcp-server
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_SECRET_KEY=""

# -----------------------------------------------------------------------------
# 4. Ingress Gateway & TLS
# -----------------------------------------------------------------------------
# Custom DNS domain pointing to the OCI Load Balancer IP.
# Leave empty to auto-use "<LB_IP>.nip.io"
DOCS_AGENT_DOMAIN=""

# TLS mode: "self-signed" or "acme" (Let's Encrypt HTTP-01 via cert-manager)
DOCS_AGENT_TLS_MODE="self-signed"
DOCS_AGENT_ACME_EMAIL="admin@example.com"

# -----------------------------------------------------------------------------
# 5. Netlify & External Website Integration
# -----------------------------------------------------------------------------
# Personal Access Token from https://app.netlify.com/user/applications#personal-access-tokens
NETLIFY_AUTH_TOKEN=""

# Netlify Site ID (API ID) or Site Name for deploying the preview/frontend
NETLIFY_SITE_ID=""

# Public HTTPS origin of your Netlify site (added to gateway-guardrails CORS allowOrigins)
# Example: "https://deploy-preview-42--competent-brattain-de2d6d.netlify.app"
NETLIFY_SITE_URL=""

# Optional path to local kubeflow/website checkout for `--mode website`
KUBEFLOW_WEBSITE_PATH="../kubeflow-website/website"
